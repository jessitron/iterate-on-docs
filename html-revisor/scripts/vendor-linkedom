#!/usr/bin/env bash
# Rebuild vendor/linkedom.mjs from node_modules, so html-revisor runs without npm install.
# Run after upgrading linkedom: npm install && npm run vendor
set -euo pipefail
here="$(cd "$(dirname "$0")/.." && pwd)"
cd "$here"
meta="$(mktemp)"
trap 'rm -f "$meta"' EXIT
version="$(node -p "require('./node_modules/linkedom/package.json').version")"
echo "export { parseHTML } from 'linkedom';" | npx esbuild --bundle --platform=node --format=esm \
  --banner:js="// linkedom $version and its dependencies, bundled by scripts/vendor-linkedom. Do not edit. Licenses: vendor/linkedom.LICENSES.txt" \
  --outfile=vendor/linkedom.mjs --metafile="$meta" --log-level=warning
{
  echo "Licenses for the packages bundled into vendor/linkedom.mjs."
  # Every package that contributed code to the bundle, from esbuild's metafile.
  for pkg in $(node -e 'for (const f of Object.keys(JSON.parse(require("fs").readFileSync(process.argv[1])).inputs)) { const m = f.match(/^node_modules\/(@[^/]+\/)?[^/]+/); if (m) console.log(m[0]) }' "$meta" | sort -u); do
    name="$(node -p "const p=require('./$pkg/package.json'); p.name + ' ' + p.version + ' (' + p.license + ')'")"
    printf '\n==== %s ====\n\n' "$name"
    cat "$pkg"/LICENSE*
  done
} > vendor/linkedom.LICENSES.txt
echo "vendor/linkedom.mjs: linkedom $version"
