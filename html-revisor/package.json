{
  "name": "html-revisor",
  "version": "0.1.0",
  "description": "Local server for leaving directives in HTML files, stored as HTML comments in the file itself",
  "type": "module",
  "main": "server.mjs",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test",
    "vendor": "scripts/vendor"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/context-async-hooks": "2.12.0",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "esbuild": "0.28.2",
    "linkedom": "0.18.13",
    "markdown-it": "15.0.2"
  }
}
